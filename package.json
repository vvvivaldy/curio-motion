{
  "name": "curio-motion",
  "version": "0.2.0-beta.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4176",
    "demo": "vite --host 127.0.0.1 --port 4176 --open /viewer.html",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx scripts/check.ts && npm run test:authoring",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "render": "node scripts/render.mjs",
    "render:baseline": "node scripts/render-baseline.mjs",
    "check:port": "node scripts/check-port.mjs",
    "preview:gif": "node scripts/preview-gif.mjs",
    "review": "node scripts/review.mjs",
    "test:authoring": "node --test scripts/check-authoring.mjs scripts/check-create-example.mjs scripts/check-distribution.mjs",
    "create:example": "node scripts/create-example.mjs",
    "check:objects": "node scripts/check-objects-browser.mjs",
    "check:starter": "node scripts/check-create-example-browser.mjs",
    "capture:controls": "node scripts/capture-controls.mjs",
    "check:carrier-variants": "node --import tsx scripts/check-carrier-variants.ts",
    "render:sound": "node --import tsx scripts/render-human-chair-sound.ts",
    "render:sound:recorded": "node --import tsx scripts/render-human-chair-recorded.ts",
    "render:art": "node --import tsx scripts/render-human-chair-art.ts",
    "render:acting": "node --import tsx scripts/render-human-chair-acting.ts",
    "demo:cat": "vite --host 127.0.0.1 --port 4176 --open \"/player.html?example=black-cat-chair\"",
    "demo:raccoon": "vite --host 127.0.0.1 --port 4176 --open \"/player.html?example=raccoon-courier\"",
    "demo:infographic": "vite --host 127.0.0.1 --port 4176 --open \"/player.html?example=delivery-infographic\"",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539",
    "@remotion/player": "4.0.539"
  },
  "devDependencies": {
    "vite": "6.4.5",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "puppeteer-core": "25.16.0",
    "@types/node": "22.15.30",
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7"
  },
  "overrides": {
    "zod@4.5.4": "4.6.6"
  }
}
